FIREBASE_PROJECT_ID=rocket-space-simulator
# Path to a service account. Leave it unset when the emulator lines below are set.
# GOOGLE_APPLICATION_CREDENTIALS=path/to/serviceAccount.json

# Local emulators. Comment these three lines out to use a real Firebase project.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Comma-separated browser origins. When unset, the API allows localhost:5173.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
