rules_version = '2';

// Player data. Mission ids must stay in sync with frontend/src/levels/data/missions.js.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validSettings(data) {
      return data.keys().hasOnly(['musicVolume', 'ambientVolume', 'playerName', 'updatedAt'])
        && data.musicVolume is number
        && data.musicVolume >= 0
        && data.musicVolume <= 1
        && data.ambientVolume is number
        && data.ambientVolume >= 0
        && data.ambientVolume <= 1
        && data.playerName is string
        && data.playerName.size() <= 16
        && data.updatedAt is string
        && data.updatedAt.size() > 0
        && data.updatedAt.size() <= 40;
    }

    function validMission(mission) {
      return mission.keys().hasOnly(['completed', 'stars', 'bestPct', 'attempts'])
        && mission.completed is bool
        && mission.stars is number
        && mission.stars >= 0
        && mission.stars <= 3
        && mission.bestPct is number
        && mission.bestPct >= 0
        && mission.bestPct <= 100
        && mission.attempts is number
        && mission.attempts >= 0
        && mission.attempts <= 1000000;
    }

    function missionOk(missions, id) {
      return !(id in missions) || validMission(missions[id]);
    }

    function validProgress(data) {
      return data.keys().hasOnly(['version', 'missions', 'updatedAt'])
        && data.version == 1
        && data.updatedAt is string
        && data.updatedAt.size() > 0
        && data.updatedAt.size() <= 40
        && data.missions is map
        && data.missions.keys().hasOnly(['earth', 'moon', 'mars'])
        && missionOk(data.missions, 'earth')
        && missionOk(data.missions, 'moon')
        && missionOk(data.missions, 'mars');
    }

    function countOk(packed, id) {
      return !(id in packed) || (packed[id] is int && packed[id] >= 1 && packed[id] <= 8);
    }

    function validPacked(packed) {
      return packed is map
        && packed.size() <= 16
        && packed.keys().hasOnly(['shield', 'boosters', 'fuel', 'food', 'water', 'medicine', 'veggie', 'astronaut', 'garden', 'scrubber', 'shelter', 'parachute', 'rover', 'antenna'])
        && countOk(packed, 'shield')
        && countOk(packed, 'boosters')
        && countOk(packed, 'fuel')
        && countOk(packed, 'food')
        && countOk(packed, 'water')
        && countOk(packed, 'medicine')
        && countOk(packed, 'veggie')
        && countOk(packed, 'astronaut')
        && countOk(packed, 'garden')
        && countOk(packed, 'scrubber')
        && countOk(packed, 'shelter')
        && countOk(packed, 'parachute')
        && countOk(packed, 'rover')
        && countOk(packed, 'antenna');
    }

    function pickText(picks, id) {
      return !(id in picks) || (picks[id] is string && picks[id].size() > 0 && picks[id].size() <= 48);
    }

    function validPicks(picks) {
      return picks is map
        && picks.size() <= 6
        && picks.keys().hasOnly(['site', 'orbit', 'window', 'craft', 'place'])
        && pickText(picks, 'site')
        && pickText(picks, 'orbit')
        && pickText(picks, 'window')
        && pickText(picks, 'craft')
        && pickText(picks, 'place');
    }

    function validFlight(data) {
      return data.keys().hasOnly(['missionId', 'at', 'success', 'pct', 'stars', 'packed', 'picks'])
        && data.missionId in ['earth', 'moon', 'mars']
        && data.at is string
        && data.at.size() > 0
        && data.at.size() <= 40
        && data.success is bool
        && data.pct is int
        && data.pct >= 0
        && data.pct <= 100
        && data.stars is int
        && data.stars >= 0
        && data.stars <= 3
        && validPacked(data.packed)
        && validPicks(data.picks);
    }

    match /progress/{userId} {
      allow read: if signedInAs(userId);
      allow create, update: if signedInAs(userId) && validProgress(request.resource.data);
      allow delete: if false;

      match /flights/{flightId} {
        allow read: if signedInAs(userId);
        allow create: if signedInAs(userId) && validFlight(request.resource.data);
        allow update, delete: if false;
      }
    }

    match /settings/{userId} {
      allow read: if signedInAs(userId);
      allow create, update: if signedInAs(userId) && validSettings(request.resource.data);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
